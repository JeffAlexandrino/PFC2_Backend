{
    "name": "comissionpro-backend",
    "version": "10.3.0",
    "main": "index.js",
    "scripts": {
        "build": "prisma generate && tsc",
        "test": "jest ./test --verbose --runInBand --testTimeout=10000",
        "test:watch": "yarn test --watch",
        "test:coverage": "yarn test --coverage --bail",
        "db:up": "docker compose up -d --remove-orphans",
        "db:down": "docker compose down",
        "prisma:dev": "node ./scripts/prisma-dev.js",
        "prisma:seed": "node ./scripts/prisma-seed.js",
        "db:reset": "yarn db:down && yarn db:up && yarn prisma:dev",
        "start:dev": "nodemon -e ts,json  src/index.ts --no-deprecations",
        "first_start": "yarn db:up && yarn prisma:dev && yarn prisma:seed && yarn start:dev",
        "ready": "yarn db:down && yarn db:up && yarn prisma:dev && yarn prisma:seed && yarn start:dev",
        "prisma:pro": "node ./scripts/prisma-pro.js",
        "start": "yarn prisma:pro && VERSION=$npm_package_version NODE_ENV=production node dist/src/index.js"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "@casl/ability": "^7.0.1",
        "@casl/prisma": "^2.0.2",
        "@auth/prisma-adapter": "^2.7.4",
        "@prisma/adapter-pg": "^7.9.0",
        "@prisma/client": "^7.9.0",
        "@types/multer": "^1.4.12",
        "bcryptjs": "^3.0.2",
        "compression": "^1.8.0",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "dotenv": "^16.5.0",
        "express": "^5.1.0",
        "express-rate-limit": "^7.5.0",
        "express-session": "^1.18.1",
        "faker-br": "^0.4.1",
        "helmet": "^7.2.0",
        "jest": "^29.7.0",
        "jsonwebtoken": "^9.0.2",
        "moment": "^2.30.1",
        "multer": "^1.4.5-lts.2",
        "nodemailer": "^9.0.3",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pdfkit": "^0.15.2",
        "pdfkit-table": "^0.1.99",
        "process": "^0.11.10",
        "query-string": "^9.1.2",
        "winston": "^3.17.0",
        "yup": "^1.6.1"
    },
    "devDependencies": {
        "@babel/core": "^7.27.1",
        "@babel/preset-env": "^7.27.2",
        "@babel/preset-typescript": "^7.27.1",
        "@faker-js/faker": "^9.7.0",
        "@types/bcryptjs": "^3.0.0",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.18",
        "@types/express": "^5.0.1",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/mocha": "^10.0.10",
        "@types/moment": "^2.13.0",
        "@types/node": "^22.15.17",
        "@types/nodemailer": "^8.0.1",
        "@types/nodemon": "^3.1.1",
        "@types/passport": "^1.0.17",
        "@types/passport-jwt": "^4.0.1",
        "@types/pdfkit": "^0.13.9",
        "@types/supertest": "^6.0.3",
        "babel-jest": "^29.7.0",
        "jest-extended": "^4.0.2",
        "nodemon": "^3.1.10",
        "prisma": "7.9.0",
        "supertest": "^7.1.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    },
    "jest": {
        "testPathIgnorePatterns": [
            "/node_modules/",
            "/dist/",
            "/src/controllers/index.ts",
            "/src/services/index.ts"
        ],
        "setupFilesAfterEnv": [
            "jest-extended/all"
        ]
    },
    "prisma": {
        "seed": "yarn ts-node ./prisma/seeds/seed.ts"
    }
}
