#API
PORT = 5000
NODE_ENV=development

#DATABASE PRISMA SERVICE
# Esta valor já está configurado para rodar localmente com docker como explica o README.
DATABASE_URL="postgresql://prisma:prisma@localhost:5433/tests"

# JSON_WEB_TOKENs
# Insira aqui um valor válido. Saiba mais no README.
JWT_SECRET=secret
# Tempo em mínutos para um ACCESS_TOKEN expirar.
JWT_ACCESS_EXPIRATION_MINUTES=300
# Tempo em dias para um REFRESH_TOKEN expirar.
JWT_REFRESH_EXPIRATION_DAYS=7



# MAIL SERVICE
# No README mostra como se podem obter estes valores para teste.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USERNAME= emaildeTeste
SMTP_PASSWORD=senhadeTeste
EMAIL_FROM=email