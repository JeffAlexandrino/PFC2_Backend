{
    "compilerOptions": {
        "target": "es6",
        "module": "nodenext",
        "moduleResolution": "node16",
        "rootDirs": ["./src", "./test"],
        "types": ["node", "jest"],
        "outDir": "./dist",
        "rootDir": ".",
        "removeComments": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "@src/*": ["./src/*"],
            "@test/*": ["./test/*"]
        }
    },
    "include": ["src/**/*.ts"]
}
